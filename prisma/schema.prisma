generator client {
  provider = "prisma-client-js"
}

// 🟢 UPGRADED MULTI-TENANT PRODUCTION RAILS
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ==========================================
// 🧑‍💼 CORE MEMBERSHIP & DASHBOARD ECOSYSTEM
// ==========================================

model User {
  id              Int           @id @default(autoincrement())
  name            String        @default("User")
  email           String        @unique
  password        String
  
  // 🛡️ Synchronized Identity & Vital Statistics Parameters
  placeOfBirth    String?
  dateOfBirth     String?
  maritalStatus   String?
  originCountry   String?       @default("Uganda")
  hostCountry     String?
  domicileStatus  String?
  passportNumber  String?
  gpsLocation     String?
  profession      String?

  // System Relations
  applications    Application[]
  logs            Activity[]
  voipAccount     VoipAccount?
  remittances     RemittanceLog[]
}

model Job {
  id           Int           @id @default(autoincrement())
  title        String
  description  String        @default("")
  applications Application[]
}

model Application {
  id     Int  @id @default(autoincrement())
  userId Int
  jobId  Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 📂 Network Registry with Google Maps Coordinate support:
model NetworkRegistry {
  id           Int      @id @default(autoincrement())
  userId       Int?
  fullName     String
  email        String
  phone        String
  country      String
  city         String
  postalCode   String
  fullAddress  String
  latitude     Float?
  longitude    Float?
  sector       String
  businessName String?
  createdAt    DateTime @default(now())
}

// ==========================================
// 🏦 REMITTANCE & SACCO INTEGRATED LEDGER
// ==========================================

model RemittanceLog {
  id                  String            @id @default(uuid())
  senderId            Int               
  user                User              @relation(fields: [senderId], references: [id], onDelete: Cascade) 
  recipientName       String
  recipientAccount    String
  amount              Float
  currency            String            @default("UGX")
  gateway             String            @default("mpesa")
  status              String            @default("PENDING")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // 🔗 Connection Nodes back to B2B SACCO Corporate Registry
  isSaccoDeposit      Boolean           @default(false)
  saccoInstitutionId  String?           // 🟢 FIXED: Remapped from subscription to institution id
  saccoInstitution    SaccoInstitution? @relation(fields: [saccoInstitutionId], references: [id])

  @@index([senderId])
}

// ==========================================
// 🏛️ B2B INSTITUTIONAL SACCO CORPORATE REGISTRY
// ==========================================

model SaccoInstitution {
  id                  String          @id @default(uuid())
  saccoLegalName      String
  registrationNumber  String          @unique // Statutory registration code issued by the Ministry of Trade, Industry & Cooperatives
  licenseType         String          // "TIER_4_MICROFINANCE", "COMMUNITY_COOP", "DISTRICT_UNION"
  headOfficeAddress   String
  primaryContactEmail String          @unique
  primaryContactPhone String
  
  // 🏦 SETTLEMENT BANKING TRUNK NODE (Where diaspora funding flows are routed)
  settlementBankName  String          // e.g., "Stanbic Bank Uganda", "Centenary Bank", "DFCU Bank"
  settlementAccountNo String
  settlementBranch    String
  swiftCode           String?         // Optional SWIFT code routing for international direct wire integrations
  
  status              String          @default("PENDING_VERIFICATION") // "PENDING_VERIFICATION", "ACTIVE", "SUSPENDED"
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // 🔗 Connection Tracking mapping incoming investment cashflows
  remittances         RemittanceLog[]

  @@index([registrationNumber])     // 🟢 FIXED: Updated to match your actual field name
}
model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  balance      Int           @default(0) // Stored in minor currency units (e.g., Cents/Shillings x 100)
  currency     String        @default("UGX")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id               String   @id @default(uuid())
  walletId         String
  wallet           Wallet   @relation(fields: [walletId], references: [id])
  reference        String   @unique // Paystack tracking ID (e.g., paystack_ref_123)
  type             String   // "DEPOSIT" (Card-to-Wallet) or "WITHDRAWAL" / "TRANSFER" (Wallet-to-Bank)
  purpose          String   // "SAVINGS_POOL", "REMITTANCE", "SACCO_CONTRIBUTION"
  amount           Int      // Amount in cents/shillings x 100
  status           String   // "PENDING", "SUCCESS", "FAILED"
  recipientAccount String?  // Stores destination phone/bank metadata if outbound
  createdAt        DateTime @default(now())
}

// ==========================================
// 📞 VOIP COMMUNICATIONS ARRAY
// ==========================================

model VoipAccount {
  id            String        @id @default(uuid())
  userId        Int           @unique // Linked to User.id (Int)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade) // 🟢 FIXED: Missing relational map added
  virtualNumber String        @unique
  balanceUGX    Float         @default(5000.0)
  tierClass     String        @default("DIASPORA_STANDARD")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  callLogs      VoipCallLog[]
}

model VoipCallLog {
  id            String      @id @default(uuid())
  voipAccountId String
  account       VoipAccount @relation(fields: [voipAccountId], references: [id], onDelete: Cascade)
  destinationNo String
  durationSecs  Int
  costUGX       Float
  status        String      @default("COMPLETED")
  createdAt     DateTime    @default(now())
}
// Expanded Data Models for KiKa Global Placements Engine

model Opportunity {
  id              String           @id @default(uuid())
  title           String           // e.g., "Senior Software Engineer", "MSc Machine Learning Research"
  type            String           // "JOB", "SCHOLARSHIP", "RESEARCH_INTERNSHIP"
  category        String           // "TECH", "HEALTHCARE", "ACADEMIC", "ENGINEERING"
  hostInstitution String           // Name of foreign company or university (e.g., "Uppsala University")
  hostCountry     String           // Destination (e.g., "Sweden", "Germany", "UAE")
  description     String           @db.Text
  requirements    String           @db.Text
  compensation    String?          // Salary range, or "FULLY_FUNDED" / "STIPEND_PROVIDED"
  applicationUrl  String?          // Direct portal link or fallback internal routing point
  isVetted        Boolean          @default(false) // Strict regulatory protection node
  createdAt       DateTime         @default(now())
  applications    JobApplication[]
}

model JobApplication {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String      // Links to your existing Diaspora/Local User Profile
  userEmail     String
  resumeUrl     String      // Cloud storage link to PDF CV
  proposalText  String      @db.Text // Cover letter or research abstract overview
  status        String      @default("PENDING") // PENDING, UNDER_REVIEW, ACCEPTED, REJECTED
  createdAt     DateTime    @default(now())
}
// Specialized Schema Models for the KiKa National Loan Sub-System

model LoanProduct {
  id               String        @id @default(uuid())
  name             String        // e.g., "OWC Poultry Equipment Loan", "PDM Value-Addition Line"
  interestRateAnnual Float       // Interest percentage (e.g., 5.0 or 8.5)
  maxAmountUGX     Float
  minSaccoShares   Float         // Minimum equity share deposit required to qualify
  repaymentTermMonths Int
  description      String        @db.Text
  applications     LoanApplication[]
}

model LoanApplication {
  id             String       @id @default(uuid())
  loanProductId  String
  product        LoanProduct  @relation(fields: [loanProductId], references: [id], onDelete: Cascade)
  userId         String       // Links to verified Diaspora Profile ID
  userEmail      String
  requestedAmount Float
  saccoSharesUGX Float        // Proved equity multiplier
  repaymentPlan  String       // Monthly, Quarterly, Bi-Annual
  status         String       @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  createdAt      DateTime     @default(now())
}
// 🏦 Specialized Schema Extensions for the KiKa Sacco Banking & Savings Sub-System

model SaccoPool {
  id               String            @id @default(uuid())
  name             String            // e.g., "Wakiso Agribusiness Diaspora Sacco", "Ankole Dairy Cooperative"
  district         String            // Geographic registration boundary in Uganda
  totalCapitalUGX  Float             @default(0)
  interestRateAuto Float             @default(4.5) // Annual dividend matching metric
  memberships      SaccoMembership[]
}

model SaccoMembership {
  id           String     @id @default(uuid())
  userId       String     // Reference binding to verified Diaspora Profile ID
  userEmail    String
  saccoPoolId  String
  saccoPool    SaccoPool  @relation(fields: [saccoPoolId], references: [id], onDelete: Cascade)
  sharesCount  Float      @default(0) // Total accumulated equity units
  savingsValue Float      @default(0) // Running liquid cash savings balance inside the Sacco
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userEmail, saccoPoolId]) // Prevents duplicate membership tracking arrays
}
